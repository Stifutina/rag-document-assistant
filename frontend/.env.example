# Скопируй в .env.local и подставь свой Space: "username/space-name"
# (для теста бэкенда из Colab можно указать полную ссылку https://xxxx.gradio.live)
VITE_SPACE_ID=username/rag-document-assistant

# Необязательно, ТОЛЬКО в .env.local для локальных тестов: твой токен Hugging Face
# (https://huggingface.co/settings/tokens, достаточно Read). Тогда GPU-квота списывается
# с твоего аккаунта, а не из лимита анонимных посетителей. НИКОГДА не добавляй его на Vercel:
# переменные VITE_* попадают в JS-бандл и видны всем.
# VITE_HF_TOKEN=hf_...
